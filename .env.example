# Database
DATABASE_URL="postgresql://user:password@localhost:5432/running_club_db"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Strava OAuth
STRAVA_CLIENT_ID="your-strava-client-id"
STRAVA_CLIENT_SECRET="your-strava-client-secret"

# Image Storage Provider: "s3" or "cloudinary"
IMAGE_PROVIDER="s3"

# AWS S3 (if IMAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-s3-bucket-name"

# Cloudinary (if IMAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Cron Job
CRON_SECRET="your-cron-secret-here"

# Test Database (SQLite for tests)
TEST_DATABASE_URL="file:./test.db"
